<===> calc/number/input.scss
a {b: -A-CALC(0)}

<===> calc/number/output.css
a {
  b: -a-calc(0);
}

<===>
================================================================================
<===> calc/punctuation/input.scss
a {b: -A-CALC(@#$%^&*({[]})_-+=|\\:""''<>,.?/)}

<===> calc/punctuation/output.css
a {
  b: -a-calc(@#$%^&*({[]})_-+=|\\:""''<>,.?/);
}

<===>
================================================================================
<===> calc/script_like/input.scss
