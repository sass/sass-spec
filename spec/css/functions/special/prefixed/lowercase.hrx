<===> calc/number/input.scss
a {b: -a-calc(0)}

<===> calc/number/output.css
a {
  b: -a-calc(0);
}

<===>
================================================================================
<===> calc/punctuation/input.scss
a {b: -a-calc(@#$%^&*({[]})_-+=|\\:""''<>,.?/)}

<===> calc/punctuation/output.css
a {
  b: -a-calc(@#$%^&*({[]})_-+=|\\:""''<>,.?/);
}

<===>
================================================================================
<===> calc/script_like/input.scss
a {b: -a-calc($c)}

<===> calc/script_like/output.css
a {
  b: -a-calc($c);
}

<===>
================================================================================
<===> calc/interpolation/input.scss
a {b: -a-calc(#{0})}

<===> calc/interpolation/output.css
a {
  b: -a-calc(0);
}

