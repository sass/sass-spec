  b: hsla(180, 60%, 50%, 0.5);
}

<===>
================================================================================
<===> negative_zero/hue/input.scss
a {b: hsl(-1 * 0, 100%, 50%)}

<===> negative_zero/hue/output.css
a {
  b: hsl(0, 100%, 50%);
}

<===>
================================================================================
<===> negative_zero/saturation/input.scss
