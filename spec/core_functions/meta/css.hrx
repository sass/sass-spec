<===>
================================================================================
<===> nested/input.scss
@use "sass:meta";
a {@include meta.css(meta.load("other"))}

<===> nested/_other.scss
b {c: d}

<===> nested/output.css
a b {
  c: d;
}

<===>
================================================================================
<===> named/input.scss
@use "sass:meta";
@include meta.css($module: meta.load("other"));

<===> named/_other.scss
a {b: c}

<===> named/output.css
a {
  b: c;
}

