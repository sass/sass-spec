<===> README.md
Most of the details of this function are tested as part of `meta.load-css()` and
for brevity, aren't repeated here.

<===>
================================================================================
<===> direct/load/input.scss
@use "sass:meta";
@include meta.css(meta.load("other"));

<===> direct/load/_other.scss
a {b: c}

<===> direct/load/output.css
a {
  b: c;
}

<===>
================================================================================
<===> direct/get_module/input.scss
@use "sass:meta";
@use "other";
@include meta.css(meta.get-module("other"));

<===> direct/get_module/_other.scss
a {b: c}

<===> direct/get_module/output.css
a {
  b: c;
}

a {
  b: c;
}

<===>
================================================================================
<===> indirect/load/input.scss
@use "sass:meta";
@use "midstream";
@include meta.css(midstream.$module);

<===> indirect/load/_midstream.scss
@use "sass:meta";
$module: meta.load("upstream");

<===> indirect/load/_upstream.scss
a {b: c}

<===> indirect/load/output.css
a {
  b: c;
}

<===>
================================================================================
<===> indirect/get_module/input.scss
@use "sass:meta";
@use "midstream";
@include meta.css(midstream.$module);

<===> indirect/get_module/_midstream.scss
@use "sass:meta";
@use "upstream";
$module: meta.get-module("upstream");

<===> indirect/get_module/_upstream.scss
a {b: c}

<===> indirect/get_module/output.css
a {
  b: c;
}

a {
  b: c;
}

