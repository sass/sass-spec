<===> input.scss
@use "sass:meta";
@include meta.load-css("midstream", $with: (a: b));

<===> _midstream.scss
@use "left" as *;
@use "right" as *;

$a: c !default;

<===> _left.scss
$a: left;

<===> _right.scss
$a: right;

<===> error
Error: This variable is available from multiple global modules.
    ,
1   | @use "left" as *;
    | ================ includes variable
2   | @use "right" as *;
    | ================= includes variable
... |
4   | $a: c !default;
    | ^^^^^^^^^^^^^^ variable use
    '
  _midstream.scss 4:1  load-css()
  input.scss 2:1       root stylesheet
