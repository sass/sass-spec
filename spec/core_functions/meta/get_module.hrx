<===> user_defined/input.scss
@use "sass:meta";
@use "other";
a {b: meta.global-variable-exists("other", $module: meta.get-module("other"))}

<===> user_defined/_other.scss
$other: c;

<===> user_defined/output.css
a {
  b: true;
}

<===>
================================================================================
<===> built_in/input.scss
@use "sass:meta";
@use "sass:math";
a {b: meta.global-variable-exists("e", $module: meta.get-module("math"))}

<===> built_in/output.css
a {
  b: true;
}

<===>
================================================================================
<===> meta/inspect/namespace/input.scss
@use "sass:meta";
a {b: meta.inspect(meta.get-module(meta))};

<===> meta/inspect/namespace/output.css
a {
  b: get-module("meta");
}

<===>
================================================================================
<===> meta/inspect/no_namespace/input.scss
@use "sass:meta";
@use "1" as one;
a {b: meta.inspect(meta.get-module(one))};

<===> meta/inspect/no_namespace/_1.scss

<===> meta/inspect/no_namespace/output.css
a {
  b: get-module();
}

<===>
================================================================================
<===> meta/type_of/input.scss
@use "sass:meta";
a {b: meta.type-of(meta.get-module(meta))};

<===> meta/type_of/output.css
a {
  b: module;
}

<===>
================================================================================
<===> equality/same_value/input.scss
@use "sass:meta";
$meta: meta.get-module(meta);
a {b: $meta == $meta}

<===> equality/same_value/output.css
a {
  b: true;
}

<===>
================================================================================
<===> equality/built_in/same/input.scss
@use "sass:meta";
a {b: meta.get-module(meta) == meta.get-module(meta)}

<===> equality/built_in/same/output.css
a {
  b: true;
}

<===>
================================================================================
<===> equality/built_in/different/input.scss
@use "sass:meta";
@use "sass:color";
a {b: meta.get-module(meta) == meta.get-module(color)}

<===> equality/built_in/different/output.css
a {
  b: false;
}

<===>
================================================================================
<===> equality/user_defined/same/input.scss
@use "sass:meta";
@use "other";
a {b: meta.get-module(other) == meta.get-module(other)}

<===> equality/user_defined/same/_other.scss

<===> equality/user_defined/same/output.css
a {
  b: true;
}

<===>
================================================================================
<===> equality/user_defined/different/input.scss
@use "sass:meta";
@use "left";
@use "right";
a {b: meta.get-module(left) == meta.get-module(right)}

<===> equality/user_defined/different/_left.scss

<===> equality/user_defined/different/_right.scss

<===> equality/user_defined/different/output.css
a {
  b: false;
}

<===>
================================================================================
<===> named/input.scss
@use "sass:meta";
@use "sass:math";

a {b: meta.global-variable-exists("e", $module: meta.get-module($module: "math"))}

<===> named/output.css
a {
  b: true;
}

